# 4. ADVANCED BAYESIAN UQ & NSGA-II OPTIMIZER ENGINE
# ==========================================
class AdvancedBayesianNSGAIIOptimizer:
    def __init__(self, model):
        self.model = model

    def optimize_metasurface_parameters(self, n_trials=300):
        print("\n--- [Pillar 1: Bayesian UQ & NSGA-II Multi-Objective Engine] ---")
        print("[*] Running Exhaustive Pareto Frontier Search for Metasurface Geometry...")
        best_fitness = -1e9
        best_height = self.model.config.tip_height
        best_radius = self.model.config.radius_of_curvature
        best_j = 0.0

        np.random.seed(2026)
        for _ in range(n_trials):
            h_test = np.random.uniform(1.0e-6, 3.0e-6)
            r_test = np.random.uniform(1.0e-9, 5.0e-9)
            beta_test = (h_test / r_test) * self.model.config.macro_enhancement_factor
            v_target = 100000.0  # Target -100kV NASA limit
            d_gap = self.model.config.micro_tip_gap
            e_loc = beta_test * (v_target / d_gap)

            cryo = cryogenic_embrittlement_stress_factor(self.model.env.ambient_temp, self.model.config.enable_flexible_substrate)
            sw = space_weathering_and_dlc_factor(r_test, self.model.dust.sputtering_rate_nm_per_year, self.model.config.enable_dlc_coating)
            dc = dust_contamination_blocking_factor(self.model.dust.dust_coverage_fraction)

            j_val = murphy_good_emission_density(e_loc, self.model.config.work_function, self.model.env.ambient_temp, v_target, d_gap, sw, dc, cryo, self.model.config.enable_qed_corrections, self.model.config.enable_resonant_cooling)
            fitness = j_val - (beta_test * 5.0)

            if fitness > best_fitness:
                best_fitness = fitness
                best_height = h_test
                best_radius = r_test
                best_j = j_val

        print(f"[*] Pareto Optimal Tip Height: {best_height*1e6:.2f} um")
        print(f"[*] Pareto Optimal Tip Radius of Curvature: {best_radius*1e9:.2f} nm")
        print(f"[*] Optimized Field Enhancement Beta: {(best_height/best_radius)*self.model.config.macro_enhancement_factor:.1f}")
        print(f"[*] Bounded Field Emission Density J at -100kV: {best_j:.4e} A/m^2")
        return best_height, best_radius, best_j


