@njit(fastmath=True)
def calculate_field_enhancement(tip_height: float, radius_curvature: float, macro_beta: float) -> float:
    beta_micro = tip_height / radius_curvature
    return beta_micro * macro_beta


@njit(fastmath=True)
def gordo_2021_temperature_dependent_conductivity(material_type: int, temp_K: float) -> float:
    T = max(temp_K, 2.0)
    if material_type == 0:
        return 1.21 * T**0.65 if T < 100 else 121.0 * (T / 300.0)**0.3
    elif material_type == 1:
        return 0.1 * T**0.85 if T < 50 else 16.0 * (T / 300.0)**0.4
    elif material_type == 2:
        return 0.065 * (T / 10.0)**0.5 if T < 100 else 0.36 * (T / 300.0)**0.3
    return 1.0


@njit(fastmath=True)
def gordo_2021_two_phase_thermal_decay(t: float, A1: float, tau1: float, A2: float, tau2: float, T0: float, enabled: bool) -> float:
    if not enabled:
        return T0
    return float(A1 * np.exp(-t / tau1) + A2 * np.exp(-t / tau2) + T0)


@njit(fastmath=True)
def child_langmuir_space_charge_limit(V_sheath: float, d_gap: float) -> float:
    if V_sheath <= 0.0:
        return 0.0
    const_factor = (4.0 / 9.0) * EPS_0 * np.sqrt(2.0 * E_CHARGE / M_E)
    return const_factor * (V_sheath**1.5) / (d_gap**2)


@njit(fastmath=True)
def qed_strong_field_correction_factor(E_local: float, qed_enabled: bool) -> float:
    if not qed_enabled or E_local <= 0.0:
        return 1.0
    field_ratio = E_local / SCHWINGER_E_FIELD
    alpha_fs = 7.2973525693e-3
    return 1.0 + ((alpha_fs / (3.0 * np.pi)) * np.log(1.0 + 1e15 * field_ratio))


@njit(fastmath=True)
def korotkov_likharev_resonant_subband_boost(E_local: float, film_thickness: float, resonant_enabled: bool) -> float:
    if not resonant_enabled or E_local <= 0.0:
        return 1.0
    a_0 = 2.34
    m_eff = 0.5 * M_E
    e_field_eV_m = E_local * E_CHARGE
    subband_term = a_0 * ((e_field_eV_m**2 * (H_BAR**2)) / (2.0 * m_eff))**(1.0/3.0)
    return min(1.0 + (subband_term / (K_B * 300.0 + 1e-22)) * 0.001, 2.5)


@njit(fastmath=True)
def E_LOCAL_BOUND(E: float) -> float:
    return max(E, 1e-12)


@njit(fastmath=True)
def murphy_good_emission_density(E_local: float, work_function_eV: float, temp_K: float, V_sheath: float, d_gap: float, sw_factor: float, dc_factor: float, cryo_factor: float, qed_enabled: bool, resonant_enabled: bool) -> float:
    if E_local <= 0.0:
        return 0.0
    j_scl = child_langmuir_space_charge_limit(V_sheath, d_gap)
    phi = work_function_eV * E_CHARGE
    A_fn = (E_CHARGE**3) / (8.0 * np.pi * H_BAR * phi)
    B_fn = (4.0 / 3.0) * (np.sqrt(2.0 * M_E) / (H_BAR * E_CHARGE)) * (phi**1.5)

    y = np.sqrt((E_CHARGE**3 * E_LOCAL_BOUND(E_local)) / (4.0 * np.pi * EPS_0)) / phi
    if y >= 1.0:
        y = 0.999

    t_y = 1.0 - y**2 + 0.11 * (y**2) * np.log(y + 1e-12)
    v_y = 1.0 - y**2 + (y**2 / 3.0) * np.log(y + 1e-12)

    J_0 = A_fn * (E_local**2) * np.exp(-B_fn * v_y / E_local)
    d = (E_CHARGE * H_BAR * E_local) / (2.0 * np.sqrt(2.0 * M_E * phi) * t_y)
    theta = (K_B * temp_K) / d

    thermal_factor = (np.pi * theta) / np.sin(np.pi * theta + 1e-12) if theta < 0.9 else 1.0 + (np.pi**2 / 6.0) * (theta**2)
    qed_corr = qed_strong_field_correction_factor(E_local, qed_enabled)
    resonant_corr = korotkov_likharev_resonant_subband_boost(E_local, 2.5e-9, resonant_enabled)

    j_calculated = J_0 * thermal_factor * sw_factor * dc_factor * cryo_factor * qed_corr * resonant_corr
    return min(j_calculated, j_scl)


@njit(fastmath=True)
def calculate_resonant_cryogenic_enhancement(E_local: float, base_current_density: float, r_0: float, R_base: float, delta_E_meV: float, temp_K: float, j_scl: float) -> float:
    protrusion_boost = R_base / max(r_0, 1e-10)
    delta_E_J = delta_E_meV * 1e-3 * E_CHARGE
    resonance_factor = 1.0 + (protrusion_boost / (1.0 + ((K_B * temp_K) / max(delta_E_J, 1e-22))))
    return min(base_current_density * resonance_factor, j_scl)


@njit(fastmath=True)
def calculate_pyroelectric_thermoelectric_harvesting_val(p_coeff: float, dT_dt: float, seebeck: float, temp_k: float, area: float, eta_fraction: float) -> float:
    j_pyro = p_coeff * dT_dt
    return j_pyro * area * eta_fraction


@njit(fastmath=True)
def cryogenic_embrittlement_stress_factor(temp_K: float, flexible_substrate: bool) -> float:
    if temp_K > 100.0:
        return 1.0
    if not flexible_substrate:
        return 0.70
    return 0.98


@njit(fastmath=True)
def space_weathering_and_dlc_factor(radius_curvature: float, sputtering_rate: float, dlc_coating: bool, operational_years: float = 1.0) -> float:
    effective_sputtering = sputtering_rate * 0.15 if dlc_coating else sputtering_rate
    degraded_radius = radius_curvature + (effective_sputtering * 1e-9 * operational_years)
    return max(0.65 if dlc_coating else 0.50, radius_curvature / degraded_radius)


@njit(fastmath=True)
def dust_contamination_blocking_factor(coverage_fraction: float) -> float:
    return max(0.20, 1.0 - coverage_fraction)


